  "deviceConfigFields": [
    {
      "id": "host",
      "type": "textinput",
      "label": "IP address",
      "required": true,
      "manualOnly": true,
      "help": "The ADTQ's address on the control network, as shown on its front panel or in Wireless Workbench. Its control port and identity are discovered from the unit itself."
    }
  ],
  "pluginConfigFields": [
    {
      "id": "discoveryNote",
      "type": "static-text",
      "label": "Discovery",
      "help": "ADTQ units on this machine's network segment are found automatically by SLP multicast (UDP 8427), the same way Wireless Workbench finds them. Units on other subnets can be asked directly by listing their addresses below, or added by IP address."
    },
    {
      "id": "addresses",
      "type": "textinput",
      "label": "Additional ADTQ addresses",
      "default": "",
      "help": "Comma-separated IP addresses to ask directly, for units that multicast does not reach."
    },
    {
      "id": "pollIntervalMs",
      "type": "number",
      "label": "Refresh interval",
      "unit": "ms",
      "default": 2000,
      "min": 500,
      "max": 30000,
      "step": 100,
      "help": "How often every channel's settings are re-read from the unit. Changes the unit pushes itself arrive at once regardless."
    },
    {
      "id": "meterIntervalMs",
      "type": "number",
      "label": "Meter interval",
      "unit": "ms",
      "default": 100,
      "min": 50,
      "max": 1000,
      "step": 10,
      "help": "How often the audio meters are read. Each read costs the unit about 30 ms of replies; 100 ms is a smooth meter with headroom."
    },
    {
      "id": "simulate",
      "type": "checkbox",
      "label": "Simulate an ADTQ",
      "default": false,
      "help": "Adds a simulated four-channel unit that speaks the real protocol on this machine, for trying the workflow with no hardware. It never talks to a real device."
    }
  ],
  "stateKeys": [
    "deviceName",
    "connection",
    "channelName",
    "frequency",
    "groupChannel",
    "mute",
    "rfState",
    "gain",
    "audioModes",
    "rfEncryption",
    "meters",
    {
      "key": "x.shure-adtq.txPowerMode",
      "scope": "channel",
      "op": "merge"
    },
    {
      "key": "x.shure-adtq.afDots",
      "scope": "channel",
      "op": "merge"
    },
    {
      "key": "x.shure-adtq.unit",
      "scope": "device",
      "op": "replace"
    },
    {
      "key": "x.shure-adtq.tone",
      "scope": "channel",
      "op": "merge"
    },
    {
      "key": "x.shure-adtq.carrier",
      "scope": "channel",
      "op": "merge"
    },
    {
      "key": "x.shure-adtq.input",
      "scope": "channel",
      "op": "merge"
    }
  ]
